digraph Arena {
 graph [rankdir=TB, nodesep=0.2, ranksep=0.3, pad=0.1];
 node [shape=record, fontname="Open Sans", fontsize=10, style=filled, fillcolor="#edf3fa"];
 edge [fontname="Open Sans", fontsize=8, arrowsize=0.6, color="#53647c"];
 Main [label="application.Main"];
 Gestion [label="{metier.GestionnaireTournois|registres ; file de priorite\nmodes : direct, threads, pool|planifier ; lancerSuivant ; close}"];
 Personne [label="{metier.Personne (abstraite)|id ; nom ; prenom\npseudo ; genre ; telephone}"];
 Joueur [label="{metier.Joueur|equipe ; statut ; victoires locales}"];
 Coach [label="{metier.Coach|equipe ; victoires carriere}"];
 Arbitre [label="{metier.Arbitre|qualifications ; compteur ; occupe}"];
 Equipe [label="{metier.Equipe : Classable|joueurs ; coach ; points ; occupee}"];
 Tournoi [label="{metier.Tournoi : Comparable|nom ; jeu ; date ; budget ; arenes\netat ; matchs ; futur du rapport}"];
 Match [label="{metier.Match (immuable)|deux equipes ; jeu ; arbitre\ncompositions ; vainqueur}"];
 Jeu [label="{jeux.Jeu (abstrait)|nom ; manches|selectionner ; getJoueursParEquipe}"];
 Solo [label="jeux.JeuSolo"];
 Collectif [label="jeux.JeuEquipe"];
 Strategie [label="{strategies.StrategieVictoire|choisir(Equipe, Equipe, Random)}"];
 Equitable [label="strategies.TirageEquitable"];
 Meilleure [label="strategies.MeilleureEquipe"];
 Depot [label="{persistance.DepotRapports|EntityManagerFactory|enregistrer ; tous ; parJeu}"];
 Rapport [label="{persistance.RapportTournoi (JPA)|id ; nomTournoi ; date ; jeu\nmatchsPrevus ; matchsJoues\nvainqueur ; reussite}"];
 Main -> Gestion;
 Main -> Depot;
 Gestion -> Tournoi [label="planifie / simule"];
 Gestion -> Depot;
 Gestion -> Strategie;
 Gestion -> Equipe [label="registre"];
 Tournoi -> Equipe [label="inscrit 0..*"];
 Tournoi -> Match [dir=both,arrowtail=diamond,arrowhead=none,label="0..*"];
 Tournoi -> Jeu [label="1"];
 Tournoi -> Rapport [label="0..1"];
 Match -> Arbitre [label="1"];
 Match -> Equipe [label="2"];
 Match -> Jeu [label="1"];
 Equipe -> Joueur [arrowhead=none,label="0..* / 0..1"];
 Equipe -> Coach [arrowhead=none,label="0..1 / 0..1"];
 Personne -> Joueur [dir=back,arrowtail=empty];
 Personne -> Coach [dir=back,arrowtail=empty];
 Personne -> Arbitre [dir=back,arrowtail=empty];
 Arbitre -> Jeu [label="qualifie"];
 Jeu -> Solo [dir=back,arrowtail=empty];
 Jeu -> Collectif [dir=back,arrowtail=empty];
 Strategie -> Equitable [dir=back,arrowtail=empty,style=dashed];
 Strategie -> Meilleure [dir=back,arrowtail=empty,style=dashed];
 Depot -> Rapport [label="seule entite"];
}

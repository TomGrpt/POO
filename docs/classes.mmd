classDiagram
    namespace application {
        class Main
    }
    namespace metier {
        class Personne {
            <<abstract>>
            -int id
            -String nom
            -String prenom
            -String pseudo
            -Genre genre
            -String telephone
        }
        class Joueur {
            -StatutJoueur statut
            -int victoiresDepuisArrivee
        }
        class Coach {
            -int victoires
        }
        class Arbitre {
            -Set~Jeu~ qualifications
            -int matchsArbitres
            -boolean occupe
        }
        class Equipe {
            -String nom
            -int points
            -boolean occupee
            +ajouterJoueur(Joueur)
            +retirerJoueur(Joueur)
            +definirCoach(Coach)
        }
        class Match {
            -Equipe vainqueur
            +estJoue() boolean
        }
        class Tournoi {
            -String nom
            -LocalDate date
            -double budget
            -int arenes
            -EtatTournoi etat
            -Future~RapportTournoi~ resultat
            +inscrire(Equipe)
            +attendreRapport(long,TimeUnit) RapportTournoi
        }
        class GestionnaireTournois {
            -ExecutorService pool
            -int enCours
            +planifier(Tournoi)
            +lancerSuivant(long,StrategieVictoire) Tournoi
            +lancerSuivant(long,StrategieVictoire,ModeExecution) Tournoi
            -List~Thread~ threads
            -List~FutureTask~ travaux
            +close()
        }
        class ModeExecution {
            <<enumeration>>
            SEQUENTIEL
            THREADS
            POOL
        }
        class Classable {
            <<interface>>
            +getPoints() int
        }
        class Verrou {
            ~Object OBJET$
        }
        class EtatTournoi {
            <<enumeration>>
            PLANIFIE
            EN_COURS
            TERMINE
        }
        class StatutJoueur {
            <<enumeration>>
            AMATEUR
            PRO
        }
        class Genre {
            <<enumeration>>
            FEMME
            HOMME
            AUTRE
            NON_PRECISE
        }
    }
    namespace jeux {
        class Jeu {
            <<abstract>>
            -String nom
            -int manches
            +getJoueursParEquipe() int
            +selectionner(Equipe) List~Joueur~
        }
        class JeuSolo
        class JeuEquipe {
            -int joueurs
        }
    }
    namespace strategies {
        class StrategieVictoire {
            <<interface>>
            +choisir(Equipe,Equipe,Random) Equipe
        }
        class TirageEquitable
        class MeilleureEquipe
    }
    namespace persistance {
        class RapportTournoi {
            <<Entity>>
            -Long id
            -String nomTournoi
            -LocalDate date
            -String jeu
            -int matchsPrevus
            -int matchsJoues
            -String vainqueur
            -boolean reussite
        }
        class DepotRapports {
            -EntityManagerFactory fabrique
            +enregistrer(RapportTournoi)
            +tous() List~RapportTournoi~
            +parJeu(String) List~RapportTournoi~
        }
    }
    namespace util {
        class Textes {
            +verifier(String)$ String
        }
    }
    Personne <|-- Joueur
    Personne <|-- Coach
    Personne <|-- Arbitre
    Classable <|.. Equipe
    Equipe "0..1" o-- "0..*" Joueur
    Equipe "0..1" o-- "0..1" Coach
    Arbitre --> "1..*" Jeu : qualifications
    Jeu <|-- JeuSolo
    Jeu <|-- JeuEquipe
    Match --> "2" Equipe
    Match --> "1" Arbitre
    Match --> "1" Jeu
    Tournoi --> "1" Jeu
    Tournoi o-- "0..*" Equipe
    Tournoi *-- "0..*" Match
    Tournoi --> "0..1" RapportTournoi
    StrategieVictoire <|.. TirageEquitable
    StrategieVictoire <|.. MeilleureEquipe
    GestionnaireTournois --> StrategieVictoire
    GestionnaireTournois --> DepotRapports
    GestionnaireTournois o-- Tournoi
    GestionnaireTournois ..> Verrou
    DepotRapports --> RapportTournoi
    Main ..> GestionnaireTournois
    Main ..> DepotRapports
    Personne ..> Textes
    Jeu ..> Textes
    Equipe ..> Textes
    Tournoi ..> Textes

    GestionnaireTournois --> ModeExecution
    Main ..> ModeExecution

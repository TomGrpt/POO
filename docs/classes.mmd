  -int nombre
  +matchTermine(Match)
  +nombre() int
 }
 class ResultatMatch {
  -String premiere
  -String seconde
  -EtatMatch etat
  -String vainqueur
 }
 StrategieVainqueur <|.. StrategieEquitable
 StrategieVainqueur <|.. StrategiePonderee
 StrategieVainqueur <|.. StrategieMeilleure
